{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Sankey diagram showing the flow from chronic conditions to daily assistance needs.",
  "width": 640,
  "height": 450,
  "padding": {"top": 20, "left": 10, "right": 10, "bottom": 30},
  "autosize": {"type": "fit", "contains": "padding"},

  "signals": [
    {
      "name": "selected_sex",
      "value": "Persons",
      "bind": {
        "input": "radio",
        "options": ["Persons", "Female", "Male"],
        "labels": ["All Persons", "Female", "Male"],
        "name": "Population View: "
      }
    },
    {
      "name": "hovered",
      "value": null,
      "on": [
        {"events": "@link:pointerover", "update": "datum"},
        {"events": "@link:pointerout", "update": "null"},
        {"events": "@source_rect:pointerover", "update": "{condition: datum.condition}"},
        {"events": "@source_rect:pointerout", "update": "null"},
        {"events": "@target_rect:pointerover", "update": "{need_for_assistance: datum.need_for_assistance}"},
        {"events": "@target_rect:pointerout", "update": "null"}
      ]
    }
  ],

  "data": [
    {
      "name": "raw_data",
      "url": "data/chart08_need_for_assistance.csv",
      "format": {
        "type": "csv",
        "parse": {
          "count": "number",
          "total_stated": "number",
          "pct_of_condition": "number",
          "is_comparator": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.is_comparator === 0 && datum.sex === selected_sex"
        }
      ]
    },
    {
      "name": "source_totals",
      "source": "raw_data",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["condition"],
          "fields": ["count"],
          "ops": ["sum"],
          "as": ["total"]
        },
        {
          "type": "stack",
          "field": "total",
          "groupby": [],
          "sort": {"field": "total", "order": "descending"},
          "as": ["y0", "y1"]
        }
      ]
    },
    {
      "name": "target_totals",
      "source": "raw_data",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["need_for_assistance"],
          "fields": ["count"],
          "ops": ["sum"],
          "as": ["total"]
        },
        {
          "type": "stack",
          "field": "total",
          "groupby": [],
          "sort": {"field": "need_for_assistance", "order": "ascending"},
          "as": ["y0", "y1"]
        }
      ]
    },
    {
      "name": "links",
      "source": "raw_data",
      "transform": [
        {
          "type": "stack",
          "groupby": ["condition"],
          "sort": {"field": "need_for_assistance", "order": "ascending"},
          "field": "count",
          "as": ["sy0", "sy1"]
        },
        {
          "type": "stack",
          "groupby": ["need_for_assistance"],
          "sort": {"field": "condition", "order": "descending"},
          "field": "count",
          "as": ["ty0", "ty1"]
        },
        {
          "type": "lookup",
          "from": "source_totals",
          "key": "condition",
          "fields": ["condition"],
          "as": ["src_node"]
        },
        {
          "type": "lookup",
          "from": "target_totals",
          "key": "need_for_assistance",
          "fields": ["need_for_assistance"],
          "as": ["tgt_node"]
        },
        {
          "type": "formula",
          "expr": "scale('y_source', datum.src_node.y0 + (datum.sy0 + datum.sy1) / 2)",
          "as": "sy"
        },
        {
          "type": "formula",
          "expr": "scale('y_target', datum.tgt_node.y0 + (datum.ty0 + datum.ty1) / 2)",
          "as": "ty"
        },
        {
          "type": "formula",
          "expr": "max(1, (scale('y_source', datum.src_node.y0 + datum.sy1) - scale('y_source', datum.src_node.y0 + datum.sy0)))",
          "as": "stroke_width"
        },
        {
          "type": "linkpath",
          "sourceX": {"expr": "180"},
          "sourceY": {"expr": "datum.sy"},
          "targetX": {"expr": "width - 190"},
          "targetY": {"expr": "datum.ty"},
          "shape": "diagonal"
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "y_source",
      "type": "linear",
      "range": [20, {"signal": "height - 20"}],
      "domain": {"data": "source_totals", "field": "y1"}
    },
    {
      "name": "y_target",
      "type": "linear",
      "range": [20, {"signal": "height - 20"}],
      "domain": {"data": "target_totals", "field": "y1"}
    },
    {
      "name": "color_assistance",
      "type": "ordinal",
      "domain": ["Has need for assistance", "No need for assistance"],
      "range": ["#E06D53", "#68A691"]
    }
  ],

  "marks": [
    {
      "type": "path",
      "name": "link",
      "from": {"data": "links"},
      "encode": {
        "update": {
          "path": {"field": "path"},
          "stroke": {"scale": "color_assistance", "field": "need_for_assistance"},
          "strokeWidth": {"field": "stroke_width"},
          "strokeOpacity": {
            "signal": "hovered === null ? 0.45 : ((hovered.condition && hovered.condition === datum.condition) || (hovered.need_for_assistance && hovered.need_for_assistance === datum.need_for_assistance) ? 0.85 : 0.08)"
          },
          "tooltip": {
            "signal": "{'Condition': datum.condition, 'Assistance Status': datum.need_for_assistance, 'Sex': datum.sex, 'Affected Individuals': format(datum.count, ','), 'Share of Condition': format(datum.pct_of_condition, '.1f') + '%', 'Total with Condition': format(datum.total_stated, ',')}"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "source_rect",
      "from": {"data": "source_totals"},
      "encode": {
        "update": {
          "x": {"value": 165},
          "width": {"value": 15},
          "y": {"scale": "y_source", "field": "y0"},
          "y2": {"scale": "y_source", "field": "y1"},
          "fill": {"value": "#0A4D52"},
          "fillOpacity": {"value": 0.9},
          "cursor": {"value": "pointer"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "source_totals"},
      "encode": {
        "update": {
          "x": {"value": 155},
          "y": {"signal": "(scale('y_source', datum.y0) + scale('y_source', datum.y1)) / 2"},
          "text": {"field": "condition"},
          "align": {"value": "right"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 10},
          "fontWeight": {"value": 600},
          "fill": {"value": "#1E293B"}
        }
      }
    },
    {
      "type": "rect",
      "name": "target_rect",
      "from": {"data": "target_totals"},
      "encode": {
        "update": {
          "x": {"signal": "width - 190"},
          "width": {"value": 15},
          "y": {"scale": "y_target", "field": "y0"},
          "y2": {"scale": "y_target", "field": "y1"},
          "fill": {"scale": "color_assistance", "field": "need_for_assistance"},
          "fillOpacity": {"value": 0.95},
          "cursor": {"value": "pointer"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "target_totals"},
      "encode": {
        "update": {
          "x": {"signal": "width - 165"},
          "y": {"signal": "(scale('y_target', datum.y0) + scale('y_target', datum.y1)) / 2"},
          "text": {"signal": "datum.need_for_assistance + ' (' + format(datum.total, '~s') + ')'"},
          "align": {"value": "left"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": 700},
          "fill": {"value": "#1E293B"}
        }
      }
    }
  ]
}